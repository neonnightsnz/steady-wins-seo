---
import PageLayout from '../../layouts/PageLayout.astro';
import { locationPages } from '../../data/locationPages';

export function getStaticPaths() {
  return locationPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
---
<PageLayout title={page.heading} description={page.sections[0]?.body ?? page.heading}>
  <h1>{page.heading}</h1>
  {page.sections.map((section) => <section><h2>{section.heading}</h2><p>{section.body}</p></section>)}
  <ul>{page.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
  <a class="button" href="/contact/">Request a quote</a>
</PageLayout>
