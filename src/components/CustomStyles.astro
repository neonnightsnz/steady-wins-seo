---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
---

<style is:inline>
  :root {
    --sw-border: #e2e5df;
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: #7ba800;
    --aw-color-secondary: #6b9400;
    --aw-color-accent: #7ba800;

    --aw-color-text-heading: rgb(6 7 10);
    --aw-color-text-default: rgb(16 16 18);
    --aw-color-text-muted: rgb(16 16 18 / 66%);
    --aw-color-bg-page: rgb(250 251 246);

    --aw-color-bg-page-dark: rgb(10 10 12);

    ::selection {
      background-color: #c0ff00;
      color: #06070a;
    }
  }

  .dark {
    --sw-border: #26262c;
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: #c0ff00;
    --aw-color-secondary: #a9e600;
    --aw-color-accent: #c0ff00;

    --aw-color-text-heading: rgb(255 255 255);
    --aw-color-text-default: rgb(245 245 247);
    --aw-color-text-muted: rgb(245 245 247 / 64%);
    --aw-color-bg-page: rgb(10 10 12);
    --aw-color-bg-page-dark: rgb(10 10 12);

    ::selection {
      background-color: #c0ff00;
      color: #06070a;
    }
  }
</style>
