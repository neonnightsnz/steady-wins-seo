---
interface Props {
  packageName: string;
  tagline?: string;
}
const { packageName, tagline } = Astro.props;
---

<form class="sw-offer-form" action="/contact" method="get" data-offer-brief>
  <p class="sw-offer-form-label"><span>Starting a brief for:</span> <strong>{packageName}</strong></p>
  <label
    >Your name
    <input type="text" name="name" placeholder="Jane Smith" autocomplete="name" maxlength="120" required />
  </label>
  <label
    >Website URL
    <input type="text" name="website" placeholder="yourbusiness.co.nz" autocomplete="off" maxlength="500" required />
  </label>
  <input type="hidden" name="package" value={packageName} />
  <button class="sw-button sw-offer-form-btn" type="submit">Get my starting point</button>
  {tagline && <p class="sw-offer-form-tagline">{tagline}</p>}
</form>
