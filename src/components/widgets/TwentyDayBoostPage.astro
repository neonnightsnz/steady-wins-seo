---
import { packages } from '~/data/packages';
import { packageExtra } from '~/data/packageExtra';
import { twentyDayBoostFaqs } from '~/data/twentyDayBoostFaqs';

const item = packages.find(({ slug }) => slug === '20-day-seo-boost');
if (!item) throw new Error('20 Day SEO Boost package is missing');
const extra = packageExtra[item.slug];
const imageHero = 'imageHero' in item ? item.imageHero : item.imageThumbnail;
---

<div class="boost-page" data-boost-page>
  <div class="boost-crumbbar">
    <div class="sw-shell"><a href="/services">← All packages</a></div>
  </div>

  <section class="boost-hero" data-boost-hero>
    <div class="boost-hero-inner">
      <img
        class="boost-hero-image"
        src={imageHero}
        alt="A businessperson pressing a green button beside a rising arrow"
        loading="eager"
        fetchpriority="high"
      />
      <div class="sw-shell boost-hero-shell">
        <div class="boost-hero-content">
          <img class="boost-badge" src={item.imageTitle} alt={item.name} width="168" />
          <h1>Your competitors are ranking. You're not.</h1>
          <p class="boost-hero-sub">
            That gap doesn't close by itself — it closes with a focused 20-day link campaign.
          </p>
          <ul class="boost-checks">
            <li>Site audit before we start</li>
            <li>10–15 backlinks, built steadily over 20 days</li>
            <li>Day 20 report: every link, URL and DR</li>
          </ul>
          <p class="boost-hero-price"><strong>$499</strong> — one-time, 20-day campaign</p>

          <form class="boost-form" id="boost-brief" data-boost-brief novalidate>
            <div class="boost-step" data-step="1">
              <label for="boost-url">What's your website?</label>
              <input
                id="boost-url"
                name="website"
                type="text"
                inputmode="url"
                autocomplete="url"
                autocapitalize="none"
                spellcheck="false"
                enterkeyhint="go"
                maxlength="500"
                placeholder="yourbusiness.co.nz"
                aria-describedby="boost-error-1"
                required
              />
              <p class="boost-error" id="boost-error-1" role="alert" hidden></p>
              <button class="sw-button boost-submit" type="submit">Continue with my site</button>
              <p class="boost-form-note">Free to prepare. No payment needed.</p>
            </div>
            <div class="boost-step" data-step="2" hidden>
              <p class="boost-conversation" data-boost-conversation></p>
              <label for="boost-name">First name</label>
              <input
                id="boost-name"
                name="firstName"
                type="text"
                autocomplete="given-name"
                autocapitalize="words"
                enterkeyhint="next"
                maxlength="120"
                aria-describedby="boost-error-2"
                required
              />
              <label for="boost-email">Email for your brief</label>
              <input
                id="boost-email"
                name="email"
                type="email"
                inputmode="email"
                autocomplete="email"
                enterkeyhint="done"
                maxlength="320"
                aria-describedby="boost-error-2"
                required
              />
              <p class="boost-error" id="boost-error-2" role="alert" hidden></p>
              <button class="sw-button boost-submit" type="submit">Prepare my brief</button>
              <p class="boost-form-note">Your details stay in this browser. Nothing is sent yet.</p>
            </div>
            <div class="boost-step" data-step="3" hidden aria-live="polite">
              <img class="boost-badge boost-done-badge" src={item.imageTitle} alt="" width="120" />
              <p class="boost-conversation" data-boost-done></p>
              <button class="sw-button boost-submit" type="button" data-boost-download>Download my brief</button>
              <a class="boost-see-more" href="#boost-deliverables">See what happens over the 20 days</a>
            </div>
          </form>
          <p class="boost-compare" data-boost-compare>
            Not sure this is the right package? <a href="/services">Compare all 9</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="boost-section" id="boost-problem">
    <div class="sw-shell">
      <h2>Every day on page 4 costs you a client</h2>
      <p class="boost-lede">
        Directory spam and link exchanges stopped working years ago. Most "link building" packages are still selling
        2015's playbook.
      </p>
      <div class="boost-problems">
        {
          extra.problems.map((problem) => (
            <article class="boost-problem">
              <h3>{problem.title}</h3>
              <p>{problem.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="boost-section" id="boost-approach">
    <div class="sw-shell">
      <h2>What actually happens</h2>
      <div class="boost-two-column">
        <div>
          <h3>What we do instead</h3>
          <p>
            We map your target keywords, identify the sites worth being on, and build a real authority pipeline into
            your site over a focused 20-day sprint — delivered steadily rather than in one batch.
          </p>
        </div>
        <div>
          <h3>Why us</h3>
          <p>
            Years in the trenches building links that survive algorithm updates, for businesses that needed results —
            not a report full of vanity metrics.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="boost-section" id="boost-deliverables">
    <div class="sw-shell">
      <h2>What you get, day by day</h2>
      <p class="boost-lede">Not a mystery box. Here's exactly where the 20 days go.</p>
      <ol class="boost-days">
        {
          extra.timeline.map((step) => (
            <li class="boost-day">
              <span class="boost-day-number">{step.range}</span>
              <div>
                <>
                  <h3>{step.label}</h3>
                  <p>{step.body}</p>
                </>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="boost-section" id="boost-proof">
    <div class="sw-shell">
      <h2>What clients say</h2>
      <div class="boost-quotes">
        {
          extra.testimonials.map((testimonial) => (
            <figure class="boost-quote">
              <blockquote>“{testimonial.text}”</blockquote>
              <figcaption>{testimonial.reviewer}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="boost-section" id="boost-fit">
    <div class="sw-shell">
      <h2>Is this the right fit?</h2>
      <div class="boost-two-column">
        <div>
          <h3>A good fit if</h3>
          <ul class="boost-plain-list">
            <li>You have a live site with real pages you want people to find</li>
            <li>You can name at least one service or search you want to rank for</li>
            <li>You want links built steadily, not dumped in one batch</li>
          </ul>
        </div>
        <div>
          <h3>Not a fit if</h3>
          <ul class="boost-plain-list">
            <li>Your site is brand new with no content yet</li>
            <li>You need a guaranteed #1 ranking in 20 days</li>
            <li>You want links built every month. See Steady On Links All Month instead</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="boost-section" id="boost-faq">
    <div class="sw-shell">
      <h2>Questions before you start</h2>
      <div class="boost-faq">
        {
          twentyDayBoostFaqs.map(({ question, answer }) => (
            <details>
              <>
                <summary>{question}</summary>
                <p>{answer}</p>
              </>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="boost-section boost-offer-section" id="boost-offer" data-boost-offer>
    <div class="sw-shell">
      <h2>The offer</h2>
      <div class="boost-offer-panel">
        <div class="boost-offer-grid">
          <div><h3>Included in the price</h3><p>{item.offer}</p></div>
          <div><h3>Capacity</h3><p>{item.capacity}</p></div>
        </div>
        <div class="boost-offer-price">
          <img src={item.imageTitle} alt="" width="128" />
          <span><strong>$499</strong> one-time, 20-day campaign</span>
        </div>
        <div class="boost-guarantee"><h3>The guarantee</h3><p>{item.guarantee}</p></div>
        <a class="sw-button boost-wide-cta" href="#boost-brief">Start my 20-day sprint</a>
      </div>
    </div>
  </section>

  <section class="boost-section" id="boost-related">
    <div class="sw-shell">
      <h2>Not quite the right fit?</h2>
      <div class="boost-related">
        <a href="/packages/links-all-month"
          ><strong>Want links every month?</strong><span>Steady On Links All Month</span></a
        >
        <a href="/services"><strong>Not sure which package?</strong><span>Compare all 9 packages</span></a>
      </div>
    </div>
  </section>

  <section class="boost-section boost-final" id="boost-final" data-boost-final>
    <div class="sw-shell">
      <h2>Ready to close the gap?</h2>
      <p>Push the button. Your competitors won't wait for you to catch up — start the sprint now.</p>
      <a class="sw-button" href="#boost-brief">Start my 20-day sprint</a>
    </div>
  </section>

  <div class="boost-sticky" data-boost-sticky>
    <p><strong>$499</strong>20 Day SEO Boost</p>
    <a class="sw-button" href="#boost-brief">Start my sprint</a>
  </div>
</div>

<style>
  .boost-page {
    --boost-border: var(--sw-border);
    --boost-surface: color-mix(in srgb, var(--aw-color-bg-page) 92%, var(--aw-color-text-default) 8%);
    color: var(--aw-color-text-default);
    background: var(--aw-color-bg-page);
  }
  .boost-page a {
    text-underline-offset: 3px;
  }
  .boost-crumbbar {
    border-bottom: 1px solid var(--boost-border);
  }
  .boost-crumbbar a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    color: var(--aw-color-text-muted);
    font-size: 0.85rem;
    text-decoration: none;
  }
  .boost-crumbbar a:hover,
  .boost-compare a:hover,
  .boost-see-more:hover {
    color: var(--aw-color-accent);
  }
  .boost-hero {
    border-bottom: 1px solid var(--boost-border);
    overflow: hidden;
  }
  .boost-hero-inner {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 660px;
  }
  .boost-hero-image {
    position: absolute;
    top: 0;
    right: 0;
    width: auto;
    max-width: none;
    height: 100%;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgb(0 0 0 / 55%) 28%, black 55%);
    mask-image: linear-gradient(to right, transparent 0%, rgb(0 0 0 / 55%) 28%, black 55%);
  }
  .boost-hero-shell {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .boost-hero-content {
    width: 100%;
    max-width: 520px;
    padding-block: 52px;
  }
  .boost-badge {
    display: block;
    width: 168px;
    height: auto;
    margin-bottom: 18px;
  }
  .boost-hero h1 {
    max-width: 13ch;
    margin: 0 0 20px;
    color: var(--aw-color-text-heading);
    font-size: clamp(2.65rem, 5vw, 4.4rem);
    font-weight: 850;
    letter-spacing: -0.055em;
    line-height: 1.02;
    text-wrap: balance;
  }
  .boost-hero-sub {
    max-width: 46ch;
    margin: 0 0 18px;
    color: var(--aw-color-text-muted);
    font-size: 1.1rem;
    line-height: 1.6;
  }
  .boost-checks,
  .boost-plain-list {
    list-style: none;
    padding: 0;
  }
  .boost-checks {
    display: grid;
    gap: 6px;
    margin: 0 0 16px;
  }
  .boost-checks li {
    position: relative;
    padding-left: 25px;
    font-size: 0.95rem;
  }
  .boost-checks li::before {
    position: absolute;
    left: 0;
    color: var(--aw-color-accent);
    content: '✓';
    font-weight: 800;
  }
  .boost-hero-price {
    margin: 0;
    color: var(--aw-color-text-muted);
    font-size: 0.95rem;
  }
  .boost-hero-price strong {
    color: var(--aw-color-text-default);
  }
  .boost-form {
    margin-top: 26px;
    padding: 22px;
    border: 1px solid var(--boost-border);
    border-radius: 18px;
    background: var(--boost-surface);
    scroll-margin-top: 110px;
  }
  .boost-step[hidden],
  .boost-error[hidden],
  .boost-compare[hidden] {
    display: none;
  }
  .boost-step label {
    display: block;
    margin: 0 0 7px;
    color: var(--aw-color-text-muted);
    font-size: 0.85rem;
    font-weight: 650;
  }
  .boost-step input {
    display: block;
    width: 100%;
    min-height: 48px;
    margin-bottom: 14px;
    padding: 11px 13px;
    border: 1px solid var(--boost-border);
    border-radius: 10px;
    background: var(--aw-color-bg-page);
    color: var(--aw-color-text-default);
    font: inherit;
    font-size: 1rem;
  }
  .boost-step input:focus {
    border-color: var(--aw-color-accent);
    outline: 2px solid var(--aw-color-accent);
    outline-offset: 2px;
  }
  .boost-step input[aria-invalid='true'] {
    border-color: #d97a72;
  }
  .boost-error {
    margin: -5px 0 12px;
    color: #e8917f;
    font-size: 0.85rem;
  }
  .boost-submit,
  .boost-wide-cta {
    width: 100%;
    justify-content: center;
    text-align: center;
  }
  .boost-form-note,
  .boost-compare,
  .boost-see-more {
    color: var(--aw-color-text-muted);
    font-size: 0.82rem;
    text-align: center;
  }
  .boost-form-note {
    margin: 11px 0 0;
  }
  .boost-compare {
    margin: 10px 0 0;
  }
  .boost-compare a {
    color: var(--aw-color-text-default);
  }
  .boost-conversation {
    margin: 0 0 18px;
    line-height: 1.5;
  }
  .boost-done-badge {
    width: 120px;
    margin-bottom: 12px;
  }
  .boost-see-more {
    display: block;
    margin-top: 14px;
  }
  .boost-section {
    padding-block: 68px;
    border-bottom: 1px solid var(--boost-border);
    scroll-margin-top: 100px;
  }
  .boost-section h2 {
    margin: 0 0 23px;
    color: var(--aw-color-text-heading);
    font-size: clamp(2rem, 3.2vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.08;
    text-wrap: balance;
  }
  .boost-lede {
    max-width: 58ch;
    margin: -8px 0 30px;
    color: var(--aw-color-text-muted);
    line-height: 1.65;
  }
  .boost-problem {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 28px;
    padding: 22px 0;
    border-top: 1px solid var(--boost-border);
  }
  .boost-problem:last-child,
  .boost-day:last-child,
  .boost-faq details:last-child {
    border-bottom: 1px solid var(--boost-border);
  }
  .boost-problem h3,
  .boost-day h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 750;
  }
  .boost-problem p,
  .boost-day p,
  .boost-two-column p,
  .boost-plain-list li,
  .boost-faq p,
  .boost-offer-panel p {
    margin: 0;
    color: var(--aw-color-text-muted);
    line-height: 1.65;
  }
  .boost-two-column,
  .boost-offer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
  }
  .boost-two-column h3,
  .boost-offer-panel h3 {
    margin: 0 0 10px;
    color: var(--aw-color-accent);
    font-size: 1rem;
    font-weight: 750;
  }
  .boost-plain-list {
    display: grid;
    gap: 9px;
    margin: 0;
  }
  .boost-plain-list li {
    position: relative;
    padding-left: 18px;
  }
  .boost-plain-list li::before {
    position: absolute;
    top: 0.75em;
    left: 0;
    width: 7px;
    height: 2px;
    background: var(--aw-color-accent);
    content: '';
  }
  .boost-days {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .boost-day {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 16px;
    padding: 21px 0;
    border-top: 1px solid var(--boost-border);
  }
  .boost-day-number {
    color: var(--aw-color-accent);
    font-size: 1.25rem;
    font-weight: 850;
    line-height: 1.25;
    white-space: nowrap;
  }
  .boost-day h3 {
    margin-bottom: 4px;
  }
  .boost-quotes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .boost-quote {
    margin: 0;
    padding-left: 18px;
    border-left: 3px solid var(--aw-color-accent);
  }
  .boost-quote blockquote {
    margin: 0 0 12px;
    line-height: 1.6;
  }
  .boost-quote figcaption {
    color: var(--aw-color-text-muted);
    font-size: 0.85rem;
  }
  .boost-faq details {
    border-top: 1px solid var(--boost-border);
  }
  .boost-faq summary {
    position: relative;
    min-height: 54px;
    padding: 17px 36px 17px 0;
    cursor: pointer;
    font-weight: 700;
    list-style: none;
  }
  .boost-faq summary::-webkit-details-marker {
    display: none;
  }
  .boost-faq summary::after {
    position: absolute;
    top: 11px;
    right: 4px;
    color: var(--aw-color-accent);
    content: '+';
    font-size: 1.5rem;
  }
  .boost-faq details[open] summary::after {
    content: '−';
  }
  .boost-faq p {
    max-width: 68ch;
    padding-bottom: 20px;
  }
  .boost-offer-panel {
    padding: 34px;
    border: 1px solid var(--boost-border);
    border-radius: 18px;
    background: var(--boost-surface);
  }
  .boost-offer-price {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin: 28px 0 22px;
    padding-top: 24px;
    border-top: 1px solid var(--boost-border);
    color: var(--aw-color-text-muted);
  }
  .boost-offer-price img {
    width: 128px;
    height: auto;
  }
  .boost-offer-price strong {
    margin-right: 8px;
    color: var(--aw-color-text-heading);
    font-size: 2.75rem;
    font-weight: 850;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .boost-guarantee {
    margin-bottom: 26px;
  }
  .boost-related {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .boost-related a {
    display: block;
    padding: 20px;
    border: 1px solid var(--boost-border);
    border-radius: 16px;
    background: var(--boost-surface);
    text-decoration: none;
  }
  .boost-related a:hover {
    border-color: var(--aw-color-accent);
  }
  .boost-related strong,
  .boost-related span {
    display: block;
  }
  .boost-related span {
    margin-top: 3px;
    color: var(--aw-color-text-muted);
    font-size: 0.95rem;
  }
  .boost-final {
    border-bottom: 0;
  }
  .boost-final h2 {
    max-width: 16ch;
  }
  .boost-final p {
    max-width: 52ch;
    margin: 0 0 24px;
    color: var(--aw-color-text-muted);
    line-height: 1.65;
  }
  .boost-sticky {
    position: fixed;
    z-index: 30;
    right: 0;
    bottom: 0;
    left: 0;
    display: none;
    align-items: center;
    gap: 14px;
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--boost-border);
    background: var(--aw-color-bg-page);
    transform: translateY(110%);
    visibility: hidden;
    transition:
      transform 220ms ease,
      visibility 0s 220ms;
  }
  .boost-sticky.is-visible {
    transform: none;
    visibility: visible;
    transition: transform 220ms ease;
  }
  .boost-sticky p {
    margin: 0;
    color: var(--aw-color-text-muted);
    font-size: 0.82rem;
    line-height: 1.3;
  }
  .boost-sticky strong {
    display: block;
    color: var(--aw-color-text-default);
    font-size: 0.95rem;
  }
  .boost-sticky .sw-button {
    margin-left: auto;
    padding: 12px 16px;
    white-space: nowrap;
  }
  @media (max-width: 820px) {
    .boost-hero-inner {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    .boost-hero-image {
      position: relative;
      width: 100%;
      height: 250px;
      object-fit: cover;
      object-position: 50% 10%;
      -webkit-mask-image: linear-gradient(to bottom, black 45%, transparent 100%);
      mask-image: linear-gradient(to bottom, black 45%, transparent 100%);
    }
    .boost-hero-content {
      max-width: none;
      margin-top: -44px;
      padding: 0 0 38px;
    }
    .boost-section {
      padding-block: 48px;
    }
    .boost-quotes {
      grid-template-columns: 1fr;
    }
    .boost-sticky {
      display: flex;
    }
    .boost-final {
      padding-bottom: 100px;
    }
  }
  @media (max-width: 700px) {
    .boost-problem,
    .boost-two-column,
    .boost-offer-grid,
    .boost-related {
      grid-template-columns: 1fr;
    }
    .boost-problem {
      gap: 6px;
    }
  }
  @media (max-width: 420px) {
    .boost-form,
    .boost-offer-panel {
      padding: 20px;
    }
    .boost-day {
      grid-template-columns: 72px 1fr;
      gap: 12px;
    }
    .boost-badge {
      width: 138px;
    }
    .boost-sticky .sw-button {
      font-size: 0.8rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .boost-sticky,
    .boost-sticky.is-visible {
      transition: none;
    }
  }
</style>

<script>
  function setupTwentyDayBoost() {
    const root = document.querySelector<HTMLElement>('[data-boost-page]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';

    const form = root.querySelector<HTMLFormElement>('[data-boost-brief]');
    const sticky = root.querySelector<HTMLElement>('[data-boost-sticky]');
    const websiteInput = root.querySelector<HTMLInputElement>('#boost-url');
    const nameInput = root.querySelector<HTMLInputElement>('#boost-name');
    const emailInput = root.querySelector<HTMLInputElement>('#boost-email');
    const downloadButton = root.querySelector<HTMLButtonElement>('[data-boost-download]');
    if (!form || !sticky || !websiteInput || !nameInput || !emailInput || !downloadButton) return;

    let website = '';
    let briefText = '';
    let started = false;
    function track(event: string, detail?: Record<string, string>) {
      const layer = (window as Window & { dataLayer?: Record<string, string>[] }).dataLayer;
      if (layer) layer.push({ event, ...detail });
    }
    function showStep(number: string) {
      form!.querySelectorAll<HTMLElement>('[data-step]').forEach((step) => {
        step.hidden = step.dataset.step !== number;
      });
      const compare = root!.querySelector<HTMLElement>('[data-boost-compare]');
      if (compare) compare.hidden = number !== '1';
      form!.querySelector<HTMLInputElement>('[data-step="' + number + '"] input')?.focus({ preventScroll: true });
    }
    function showError(number: string, input: HTMLInputElement, message: string) {
      const error = form!.querySelector<HTMLElement>('#boost-error-' + number);
      if (!error) return;
      error.textContent = message;
      error.hidden = !message;
      if (message) input.setAttribute('aria-invalid', 'true');
      else input.removeAttribute('aria-invalid');
    }
    form.addEventListener('focusin', () => {
      if (started) return;
      started = true;
      track('form_start');
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const active = form.querySelector<HTMLElement>('[data-step]:not([hidden])');
      if (active?.dataset.step === '1') {
        const raw = websiteInput.value.trim();
        let domain = '';
        try {
          const url = new URL(/^https?:\/\//i.test(raw) ? raw : 'https://' + raw);
          domain = url.hostname.replace(/^www\./i, '').toLowerCase();
        } catch {
          // The message below covers invalid URLs.
        }
        if (!/^[a-z0-9-]+(?:\.[a-z0-9-]+)+$/i.test(domain) || !domain.includes('.')) {
          showError('1', websiteInput, 'Enter your website address, like yourbusiness.co.nz');
          websiteInput.focus();
          return;
        }
        showError('1', websiteInput, '');
        website = domain;
        const conversation = form.querySelector<HTMLElement>('[data-boost-conversation]');
        if (conversation)
          conversation.textContent = "Got it. We'll start with " + website + '. What should we call you?';
        track('form_step1_complete');
        showStep('2');
      } else if (active?.dataset.step === '2') {
        const name = nameInput.value.trim();
        const email = emailInput.value.trim();
        if (!name) {
          showError('2', nameInput, 'Add your first name for the brief.');
          nameInput.focus();
          return;
        }
        showError('2', nameInput, '');
        if (!emailInput.validity.valid || !email) {
          showError('2', emailInput, 'Enter a valid email address.');
          emailInput.focus();
          return;
        }
        showError('2', emailInput, '');
        briefText = [
          'STEADY WINS — 20 DAY SEO BOOST BRIEF',
          '',
          'Website: ' + website,
          'First name: ' + name,
          'Email: ' + email,
          'Package: 20 Day SEO Boost',
          'Price: $499, one-time',
          '',
          'Prepared locally. This brief has not been sent to Steady Wins.',
        ].join('\n');
        const done = form.querySelector<HTMLElement>('[data-boost-done]');
        if (done)
          done.textContent =
            'Thanks, ' + name + '. Your brief for ' + website + ' is ready to download. Nothing has been sent yet.';
        track('brief_prepare');
        showStep('3');
      }
    });
    downloadButton.addEventListener('click', () => {
      if (!briefText) return;
      const url = URL.createObjectURL(new Blob([briefText], { type: 'text/plain;charset=utf-8' }));
      const link = document.createElement('a');
      link.href = url;
      link.download = 'steady-wins-20-day-seo-boost-brief.txt';
      document.body.append(link);
      link.click();
      link.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
      track('brief_download');
    });
    root.querySelectorAll<HTMLAnchorElement>('a[href="#boost-brief"]').forEach((link) => {
      link.addEventListener('click', () => {
        track('cta_click', { location: link.closest('[data-boost-sticky]') ? 'sticky' : 'page' });
        window.setTimeout(() => {
          form.querySelector<HTMLInputElement>('[data-step]:not([hidden]) input')?.focus({ preventScroll: true });
        }, 400);
      });
    });

    if ('IntersectionObserver' in window) {
      let heroVisible = true;
      let offerVisible = false;
      let finalVisible = false;
      const updateSticky = () => {
        sticky.classList.toggle('is-visible', !heroVisible && !offerVisible && !finalVisible);
      };
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.target.hasAttribute('data-boost-hero')) heroVisible = entry.isIntersecting;
            if (entry.target.hasAttribute('data-boost-offer')) offerVisible = entry.isIntersecting;
            if (entry.target.hasAttribute('data-boost-final')) finalVisible = entry.isIntersecting;
          });
          updateSticky();
        },
        { threshold: 0.1 }
      );
      root.querySelectorAll('[data-boost-hero], [data-boost-offer], [data-boost-final]').forEach((section) => {
        observer.observe(section);
      });
    }
  }

  setupTwentyDayBoost();
  document.addEventListener('astro:page-load', setupTwentyDayBoost);
</script>
