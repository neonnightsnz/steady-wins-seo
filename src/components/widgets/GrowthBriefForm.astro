---
import { packages } from '~/data/packages';
interface Props {
  id?: string;
  showHeading?: boolean;
}
const { id = 'growth-brief', showHeading = true } = Astro.props;
---

{showHeading && <h2>Start with the essentials.</h2>}

<form class="sw-form" id={id} data-growth-brief-ready>
  <label>Your name<input name="name" autocomplete="name" required maxlength="120" /></label>
  <label
    >Website URL<input
      type="url"
      name="website"
      placeholder="https://yourwebsite.com"
      required
      maxlength="500"
    /></label
  >
  <label
    >Package interest<select name="package" id={`package-choice-${id}`}
      ><option value="Not sure yet">Find my starting point</option>{
        packages.map((item) => <option value={item.name}>{item.name}</option>)
      }</select
    ></label
  >
  <label
    >Your growth priority<textarea
      name="priority"
      placeholder="What do you sell, who do you serve, and what do you want to improve?"
      required
      maxlength="3000"></textarea></label
  >
  <label
    >Budget or timing (optional)<input name="budget" maxlength="300" /><small
      >Include any scope constraints or important business dates.</small
    ></label
  >
  <button class="sw-button" type="submit">Download my brief <span aria-hidden="true">↓</span></button>
  <p id={`brief-status-${id}`} class="sw-status" role="status" aria-live="polite"></p>
</form>
<noscript
  ><p>Downloading a brief requires JavaScript. You can copy the questions above into a document instead.</p></noscript
>

<script>
  function setupGrowthBrief() {
    document.querySelectorAll<HTMLFormElement>('.sw-form[data-growth-brief-ready]').forEach((form) => {
      if (form.dataset.ready) return;
      form.dataset.ready = 'true';
      const id = form.id || 'growth-brief';
      const select = form.querySelector<HTMLSelectElement>('select[name="package"]');
      const requested = new URLSearchParams(window.location.search).get('package');
      if (select && requested && Array.from(select.options).some((option) => option.value === requested))
        select.value = requested;
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const data = new FormData(form);
        const content = [
          'STEADY WINS — GROWTH BRIEF',
          '',
          'Name: ' + data.get('name'),
          'Website: ' + data.get('website'),
          'Package: ' + data.get('package'),
          '',
          'Priority:',
          String(data.get('priority')),
          '',
          'Budget or timing: ' + (data.get('budget') || 'Not specified'),
          '',
          'Prepared locally. This brief has not been sent to Steady Wins.',
        ].join('\n');
        const url = URL.createObjectURL(new Blob([content], { type: 'text/plain;charset=utf-8' }));
        const link = document.createElement('a');
        link.href = url;
        link.download = 'steady-wins-growth-brief.txt';
        document.body.append(link);
        link.click();
        link.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
        const status = document.getElementById('brief-status-' + id);
        if (status) status.textContent = 'Your brief is ready to save. Nothing has been sent to Steady Wins.';
      });
      // Enable submit only after the local handler exists: no accidental GET without JavaScript.
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (btn) btn.removeAttribute('disabled');
    });
  }
  setupGrowthBrief();
  document.addEventListener('astro:page-load', setupGrowthBrief);
</script>
