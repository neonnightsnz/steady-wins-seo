---
import { Icon } from 'astro-icon/components';
import { packages } from '~/data/packages';
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const items = compact ? packages.slice(0, 3) : packages;
---

<div class="sw-package-grid">
  {
    items.map((item, index) => (
      <a
        class="sw-package"
        href={`/packages/${item.slug}`}
        style={`--package-accent:${item.color};--package-glow:${item.color}40;--package-index:${index}`}
        data-aw-glow
      >
        <div class="sw-package-top">
          <>
            <span class="sw-package-cat">{item.category}</span>
            <span>{String(index + 1).padStart(2, '0')}</span>
          </>
        </div>
        <div class="sw-package-image-wrap">
          <img class="sw-package-image" src={item.imagePackages} alt={item.imageAlt} loading="lazy" />
        </div>
        <Icon name={item.icon} class="sw-package-icon" />
        <h3>{item.name}</h3>
        <p class="sw-package-tagline">{item.tagline}</p>
        {item.price && <p class="sw-package-price">{item.price}</p>}
        <p class="sw-package-desc">{item.line}</p>
        <div class="sw-package-bottom">
          Explore package <span aria-hidden="true">↗︎</span>
        </div>
      </a>
    ))
  }
</div>

<script>
  // Mouse-tracking border glow for package cards (respects reduced motion).
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-aw-glow]').forEach((card) => {
    card.addEventListener('mousemove', (e: MouseEvent) => {
      if (reduced) return;
      const r = card.getBoundingClientRect();
      card.style.setProperty('--sw-mx', (e.clientX - r.left).toFixed(1) + 'px');
      card.style.setProperty('--sw-my', (e.clientY - r.top).toFixed(1) + 'px');
    });
  });
</script>
