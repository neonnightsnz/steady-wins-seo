---
import SiteLayout from '~/layouts/SiteLayout.astro';
import { site } from '~/data/site';
---

<SiteLayout title="Book a call" description="Start a conversation with Steady Wins about your next SEO move.">
  <section class="detail-hero">
    <div class="page-shell">
      <p class="eyebrow">Steady Wins / Contact</p><h1>Make your next move<br /><em>count.</em></h1><p class="lead">
        Choose a time to speak with an expert about your search engine visibility and the offer that fits your business.
      </p>
    </div>
  </section>
  <section class="contact-layout page-shell">
    <div>
      <p class="eyebrow">01 / Book a call</p><h2>Speak with an expert about your next move.</h2><p class="lead">
        The booking placeholder is ready for a Cal.com URL when you have one. Forms are not the focus of this showcase.
      </p>
    </div><div class="booking-box">
      {
        site.bookingUrl ? (
          <iframe title="Book a call" src={site.bookingUrl} width="100%" height="480" loading="lazy" />
        ) : (
          <div>
            <>
              <p>Booking will appear here once the Cal.com URL is configured.</p>
              <code>bookingUrl: ''</code>
            </>
          </div>
        )
      }
    </div>
  </section>
</SiteLayout>
