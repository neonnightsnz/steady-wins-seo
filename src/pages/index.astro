---
import Layout from '~/layouts/PageLayout.astro';
import Features from '~/components/widgets/Features.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import PackageGrid from '~/components/widgets/PackageGrid.astro';
import ValueStack from '~/components/widgets/ValueStack.astro';
import GrowthBriefForm from '~/components/widgets/GrowthBriefForm.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, I18N } from 'astrowind:config';
const metadata = {
  title: 'Steady Wins — Keywords That Rank',
  ignoreTitleTemplate: true,
  description:
    'Target the terms. Build your search momentum. Explore the Steady Wins Keyword Ranking Engine and find your next move.',
};
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.site,
    inLanguage: I18N.language,
    publisher: { '@id': SITE.site + '/#organization' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': SITE.site + '/#organization',
    name: SITE.name,
    url: SITE.site,
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={schema} />
  <section class="sw-hero" id="start">
    <div class="sw-glow-canvas" aria-hidden="true">
      <div class="sw-glow-spot sw-glow-spot--md" style="top:-160px;left:-100px;"></div>
      <div class="sw-glow-spot sw-glow-spot--md sw-glow-spot--accent" style="top:120px;right:-160px;"></div>
    </div>
    <div class="sw-shell" style="position:relative;z-index:1;">
      <div class="sw-hero-top">
        <span class="sw-status-pill"><span class="sw-status-dot"></span> Keywords That Rank</span><span
          class="sw-eyebrow">Search with purpose. ↗︎</span
        >
      </div>
      <h1>Target the terms.<br />Own your <span class="sw-kw">next move</span>.</h1>
      <div class="sw-hero-lower">
        <div>
          <p>Build your Keyword Ranking Engine around the searches that matter to your business.</p>
          <div class="sw-hero-form">
            <p class="sw-eyebrow sw-eyebrow--form">Start with a brief</p>
            <GrowthBriefForm showHeading={false} id="hero-growth-brief" />
          </div>
          <a class="sw-button sw-hero-cta" href="#packages">Explore the packages <span aria-hidden="true">↗︎</span></a>
        </div>
        <div class="sw-engine">
          <span class="sw-engine-label"><span class="sw-status-dot"></span> Your search strategy, in motion</span><ol>
            <li><span>01</span> Find your buyer's search.</li><li><span>02</span> Give it the right destination.</li><li
            >
              <span>03</span> Build your next move around it.
            </li>
          </ol>
        </div>
      </div>
    </div>
  </section></Layout
>
