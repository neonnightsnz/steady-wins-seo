---
import SiteLayout from '~/layouts/SiteLayout.astro';
import OfferCard from '~/components/site/OfferCard.astro';
import { offers } from '~/data/offers';
---

<SiteLayout
  title="SEO that keeps moving"
  description="Steady Wins SEO offers for businesses ready to improve their online presence."
>
  <section class="hero">
    <div class="page-shell">
      <div class="hero-meta"><span>Steady Wins / SEO offers</span><span>Keywords. Content. Links.</span></div><h1
        class="display"
      >
        Make your search<br /><em>move steady.</em>
      </h1><div class="hero-lower">
        <p class="lead">
          Welcome to Steady Wins SEO, the premier provider of search engine optimization services for businesses looking
          to increase their online presence and attract more qualified leads.
        </p><a class="button" href="/offers">Explore the offers <span aria-hidden="true">↗</span></a>
      </div><div
        class="hero-art"
        style={`background-image:url('${offers[4].image}')`}
        role="img"
        aria-label={offers[4].imageAlt}
      >
      </div>
    </div>
  </section>
  <div class="page-shell">
    <div class="ticker">
      <span>Search visibility ↗</span><span>Relevant content ↗</span><span>Steady momentum ↗</span><span
        >Qualified leads ↗</span
      >
    </div>
  </div>
  <section class="section">
    <div class="page-shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">01 / Find your next move</p><h2>Nine ways to put your search ambition to work.</h2>
        </div><p>
          Explore the Steady Wins catalogue of SEO services. Choose the direction that fits where your business is right
          now.
        </p>
      </div><div class="offer-grid">{offers.map((offer, index) => <OfferCard offer={offer} index={index} />)}</div>
    </div>
  </section>
  <section class="section">
    <div class="page-shell split">
      <div>
        <p class="eyebrow">02 / Search with purpose</p><h2>Visibility is only useful when it leads somewhere.</h2>
      </div><ol class="numbered-list">
        <li><span>01</span><strong>Identify the searches that matter to your business.</strong></li><li>
          <span>02</span><strong>Give those searches the right destination.</strong>
        </li><li><span>03</span><strong>Build your next move around them.</strong></li>
      </ol>
    </div>
  </section>
  <section class="section">
    <div class="page-shell">
      <div class="cta-panel">
        <div><p class="eyebrow">03 / Start the conversation</p><h2>Ready to make the next move count?</h2></div><a
          class="button button-dark"
          href="/contact">Book a call <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
  </section>
</SiteLayout>
