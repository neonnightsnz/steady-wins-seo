---
import Layout from '~/layouts/PageLayout.astro';
import ValueStack from '~/components/widgets/ValueStack.astro';
---

<Layout
  metadata={{
    title: 'Pricing and scope',
    description: 'Define the right Steady Wins package scope for your website, priorities, and budget.',
  }}
  ><div class="sw-shell">
    <header class="sw-page-intro">
      <p class="sw-eyebrow">Define the work first</p><h1 class="sw-page-title">
        Clear scope.<br />A considered investment.
      </h1><p class="sw-lead">
        Your website, market, and priorities shape the work. Package pricing is confirmed with the scope.
      </p><a class="sw-button" href="/contact">Build my growth brief ↗︎</a>
    </header><ValueStack /><section class="sw-content">
      <h2>Bring the details that count.</h2><ul>
        <li>Your website and the offer you want people to find.</li><li>The locations or audiences you serve.</li><li>
          The package you are exploring and your current priorities.
        </li><li>Your budget and any important business dates.</li>
      </ul><p>Discuss deliverables, fees, timing, and any recurring commitment before starting.</p><a
        class="sw-text-link"
        href="/services">Compare the package options ↗︎</a
      >
    </section>
  </div></Layout
>
