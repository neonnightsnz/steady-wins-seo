---
import Layout from '~/layouts/PageLayout.astro';
import { packages } from '~/data/packages';
import { packageExtra } from '~/data/packageExtra';
import OfferBriefForm from '~/components/widgets/OfferBriefForm.astro';
export function getStaticPaths() {
  return packages.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
interface Copy {
  problem?: string;
  what?: string;
  why?: string;
  whatYouGet?: readonly string[];
  offer?: string;
  price?: string;
  capacity?: string;
  guarantee?: string;
  cta?: string;
}
interface Item {
  slug: string;
  name: string;
  description?: string;
  category: string;
  tagline?: string;
  intro?: string;
  price?: string;
  image?: string;
  imageV2?: string;
  imagePackages?: string;
  imageAlt?: string;
  icon?: string;
  color?: string;
  capacity?: string;
  guarantee?: string;
  offer?: string;
  copy?: Copy;
}
const { item } = Astro.props as unknown as { item: Item };
const c = item.copy ?? {};
const extra = packageExtra[item.slug] ?? { problems: [], timeline: [], testimonials: [] };
---

<Layout metadata={{ title: item.name, description: item.description }}>
  {/* Hero: image left, brief form right */}
  <section class="sw-offer-hero">
    <div class="sw-glow-canvas" aria-hidden="true">
      <div class="sw-glow-spot sw-glow-spot--md" style="top:-140px;left:-120px;"></div>
      <div class="sw-glow-spot sw-glow-spot--sm sw-glow-spot--accent" style="top: 60px; right: 8%;"></div>
    </div>
    <div class="sw-shell">
      <header class="sw-offer-intro">
        <a class="sw-back-link" href="/packages">← All packages</a>
        <span class="sw-status-pill"><span class="sw-status-dot"></span>{item.category} package</span>
        <h1 class="sw-offer-title">{item.name}</h1>
        <p class="sw-offer-line">{item.intro}</p>
        <div class="sw-offer-price">{item.price}</div>
        <div class="sw-offer-hero2">
          <div class="sw-offer-hero-image">
            <img src={item.imageV2} alt={item.imageAlt} loading="eager" fetchpriority="high" />
          </div>
          <div class="sw-offer-form-wrap">
            <OfferBriefForm packageName={item.name} />
          </div>
        </div>
      </header>
    </div>
  </section>

  {/* Problem section */}
  {
    extra.problems.length > 0 && (
      <section class="sw-shell sw-section">
        <div class="sw-section-heading">
          <div>
            <h2>Every day on page 4 costs you a client</h2>
            <p class="sw-lead">{c.problem}</p>
          </div>
        </div>
        <div class="sw-problem-grid">
          {extra.problems.map((prob) => (
            <article class="sw-problem-card">
              <h3>{prob.title}</h3>
              <p>{prob.body}</p>
            </article>
          ))}
        </div>
      </section>
    )
  }

  {/* What actually happens */}
  {
    (c.what || c.why) && (
      <section class="sw-shell sw-section sw-what">
        <div class="sw-section-heading">
          <h2>What actually happens</h2>
        </div>
        <div class="sw-what-grid">
          {c.what && (
            <div class="sw-copy-block">
              <h3>What we do instead</h3>
              <p>{c.what}</p>
            </div>
          )}
          {c.why && (
            <div class="sw-copy-block">
              <h3>Why us</h3>
              <p>{c.why}</p>
            </div>
          )}
        </div>
      </section>
    )
  }

  {/* Timeline / day-by-day */}
  {
    extra.timeline.length > 0 && (
      <section class="sw-shell sw-section sw-timeline">
        <div class="sw-section-heading">
          <h2>What you get, step by step</h2>
          {item.name === '20 Day SEO Boost' && (
            <p class="sw-lead">Not a mystery box. Here's exactly where the 20 days go.</p>
          )}
        </div>
        <ol class="sw-timeline-list">
          {extra.timeline.map((step) => (
            <li class="sw-timeline-item">
              <span class="sw-timeline-range">{step.range}</span>
              <div>
                <h3>{step.label}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {/* Testimonials */}
  {
    extra.testimonials.length > 0 && (
      <section class="sw-shell sw-section sw-proof">
        <div class="sw-section-heading">
          <h2>What clients say</h2>
        </div>
        <div class="sw-proof-grid">
          {extra.testimonials.map((t) => (
            <figure class="sw-proof-card">
              <blockquote>"{t.text}"</blockquote>
              <figcaption>{t.reviewer}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  {/* Offer stack */}
  {
    (c.offer || item.price || c.capacity || c.guarantee) && (
      <section class="sw-shell sw-section sw-offer-stack-sec">
        <div class="sw-section-heading">
          <h2>The offer</h2>
        </div>
        <div class="sw-offer-stack-grid">
          {c.offer && (
            <div class="sw-offer-card">
              <h3>Included, not upsold</h3>
              <p>{c.offer}</p>
            </div>
          )}
          {c.capacity && (
            <div class="sw-offer-card">
              <h3>Capacity</h3>
              <p>{c.capacity}</p>
            </div>
          )}
          {c.guarantee && (
            <div class="sw-offer-card sw-offer-card--glow">
              <h3>The guarantee</h3>
              <p>{c.guarantee}</p>
            </div>
          )}
        </div>
        {item.price && <div class="sw-offer-price sw-offer-price--big">{item.price}</div>}
        <div class="sw-offer-cta">
          <a class="sw-button" href="#offer">
            Lock it in <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )
  }

  {/* Final CTA */}
  {
    c.cta && (
      <section class="sw-shell sw-section" id="offer">
        <div class="sw-close">
          <div>
            <p class="sw-eyebrow">Ready to close the gap?</p>
            <h2>{c.cta}</h2>
          </div>
          <div class="sw-close-form">
            <OfferBriefForm packageName={item.name} />
          </div>
        </div>
      </section>
    )
  }
</Layout>
