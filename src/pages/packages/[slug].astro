---
import Layout from '~/layouts/PageLayout.astro';
import { packages } from '~/data/packages';
export function getStaticPaths() {
  return packages.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
---

<Layout metadata={{ title: item.name, description: item.description }}>
  <div class="sw-shell">
    <header class="sw-page-intro">
      <a class="sw-text-link" href="/services">← All packages</a><p class="sw-eyebrow mt-10">{item.category}</p><div class="sw-detail-image-wrap"><img class="sw-detail-image" src={item.image} alt={item.imageAlt} /></div><h1
        class="sw-page-title"
      >
        {item.name}
      </h1><p class="sw-lead">{item.line}</p>
    </header><div class="sw-value sw-section">
      <div>
        <h2>Make it fit<br />your business.</h2><p class="sw-lead">{item.description}</p><a
          class="sw-button"
          href={`/contact?package=${encodeURIComponent(item.name)}`}>Build my growth brief ↗</a
        >
      </div><div>
        <p class="sw-eyebrow">What to discuss</p><ul>
          {item.focus.map((focus) => <li class="border-b border-border py-5 text-xl font-semibold">{focus}</li>)}
        </ul><p class="sw-lead">
          Final deliverables, pricing, and timing are agreed for your scope before work begins.
        </p>
      </div>
    </div>
  </div>
</Layout>
