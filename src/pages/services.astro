    description: 'Explore nine Steady Wins packages for keyword strategy, content, links, and focused SEO work.',
  }}
>
  <div class="sw-shell">
    <header class="sw-page-intro">
      <p class="sw-eyebrow">The Steady Wins catalogue</p><h1 class="sw-page-title">Choose your next move.</h1><p
        class="sw-lead"
      >
        Nine focused options. Start with the priority that matters to your business.
      </p>
    </header><section class="pb-24" aria-label="SEO packages"><PackageGrid /></section><section class="sw-close">
      <h2>Find your direction.<br />Define the work.</h2><a class="sw-button" href="/contact">Build my growth brief ↗</a
      >
    </section>
  </div>
</Layout>
