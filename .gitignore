# build output
dist/
.output/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# pnpm-specific files: pnpm is supported for local use (see .pnpmrc), but
# package-lock.json is the tracked lockfile and npm is what CI, Docker and
# the deploy targets run. Committing these would let the two trees diverge.
pnpm-lock.yaml
pnpm-workspace.yaml

.astro
# Local mirror captures and publication archives
steadywins/hts-cache/
steadywins/accounts.google.com/
steadywins/ssl.gstatic.com/
steadywins/cookies.txt
steadywins/hts-log.txt
steadywins/*.html
steadywins/*.gif
.openai/*.tar.gz

# ==============================================================================
# Custom Workspace Management & Architecture Layer
# ==============================================================================

# --- System & Deployment Performance Overrides ---
# Exclude heavy prototype structures and retired hosting environments from cloud fetches
docs/archive/

# --- Dynamic Asset De-duplication ---
# Filter raw binary files that have already been integrated into /public or /src/assets
docs/reference-material/**/*.psd
docs/reference-material/**/*.ai
docs/reference-material/**/*.raw

# --- AI Agent Workspace & Automated Context Control ---
# Eliminate workspace noise and infinite tracking loops caused by automated code loops
docs/ai-context/*_scratchpad*
docs/ai-context/*log*
.cursorrules_cache/
.cline/
.devin/
agent_workspace/

# Top-level local AI workspace (project skills already tracked remain tracked)
.agents/
